generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  name                    String?
  password                String?
  image                   String?
  events                  Event[]
  habits                  Habit[]
  notes                   Note[]
  tasks                   Task[]
  tags                    Tag[]
  pushSubscriptions       PushSubscription[]
  notificationPreferences NotificationPreferences?
  scheduledNotifications  ScheduledNotification[]
  theme                   String?                  @default("default")
  taskResetPreference     String                   @default("never")
}

model Tag {
  id     String @id @default(uuid())
  name   String
  color  String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]
}

model Event {
  id              String   @id @default(uuid())
  title           String
  start           DateTime
  end             DateTime
  reminderMinutes Int      @default(15)
  repeat          String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
}

model Note {
  id      String   @id @default(uuid())
  content String
  date    DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
}

model Habit {
  id            String   @id @default(uuid())
  name          String
  weekData      String
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastResetDate DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
}

model Task {
  id          String    @id @default(uuid())
  text        String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tags        Tag[]
}

model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  endpoint     String
  subscription String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model NotificationPreferences {
  id                    String   @id @default(uuid())
  userId                String   @unique
  eventReminders        Boolean  @default(true)
  dailyTaskSummary      Boolean  @default(true)
  habitReminders        Boolean  @default(true)
  reminderMinutesBefore Int      @default(15)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduledNotification {
  id           String    @id @default(uuid())
  userId       String
  type         String
  scheduledFor DateTime
  sent         Boolean   @default(false)
  sentAt       DateTime?
  payload      String    @db.Text
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduledFor, sent])
}